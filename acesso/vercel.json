{
  "version": 2,
  "builds": [
    {
      "src": "api/index.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "private/**"
        ]
      }
    },
    {
      "src": "public/index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "^/$",
      "dest": "/public/index.html"
    },
    {
      "src": "^/(api/.*|dashboard|relatorio)$",
      "dest": "/api/index.mjs"
    },
    {
      "src": "^/.*$",
      "status": 404,
      "dest": "/public/index.html"
    }
  ]
}
